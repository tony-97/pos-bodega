@page "/clientes"
@inject AuthService Auth
@inject ClienteService ClienteSvc
@inject NavigationManager Nav

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-surface-50">Gestión de Clientes</h1>
            <p class="text-surface-400 text-sm mt-1">Búsqueda precisa por DNI, N° Cliente (#ID) y resolución de homónimos</p>
        </div>
        <button @onclick="ShowCreate" class="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-500 hover:to-primary-400 text-white rounded-xl font-medium text-sm transition-all shadow-lg shadow-primary-600/20">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Nuevo Cliente
        </button>
    </div>

    <!-- Summary Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-surface-900 border border-surface-800 rounded-xl p-4">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-surface-400 font-medium">Total Clientes</span>
                <span class="p-1.5 rounded-lg bg-surface-800 text-surface-300">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
                </span>
            </div>
            <p class="text-xl font-bold text-surface-50">@clientes.Count</p>
            <p class="text-xs text-surface-500 mt-0.5">clientes registrados en el sistema</p>
        </div>

        <div class="bg-surface-900 border border-surface-800 rounded-xl p-4">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-amber-400 font-medium">Clientes con Fiado</span>
                <span class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400 font-bold text-xs">@ClientesConDeudaCount</span>
            </div>
            <p class="text-xl font-bold text-surface-50">@ClientesConDeudaCount</p>
            <p class="text-xs text-surface-500 mt-0.5">cuentas con saldo deudor pendiente</p>
        </div>

        <div class="bg-surface-900 border border-surface-800 rounded-xl p-4">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-rose-400 font-medium">Total Cuentas por Cobrar</span>
                <span class="p-1.5 rounded-lg bg-rose-500/10 text-rose-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                </span>
            </div>
            <p class="text-xl font-bold text-rose-400 font-mono">S/ @TotalSaldoDeudor.ToString("N2")</p>
            <p class="text-xs text-surface-500 mt-0.5">monto pendiente de cobro</p>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="bg-surface-900 border border-surface-800 rounded-xl p-4 space-y-3">
        <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
            <!-- Search input -->
            <div class="relative flex-1">
                <input type="text" @bind="searchQuery" @bind:event="oninput"
                       placeholder="Buscar por DNI, N° Cliente (#ID), RUC, Nombre o Teléfono..."
                       class="w-full pl-10 pr-4 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 placeholder-surface-500 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                <svg class="w-4 h-4 text-surface-400 absolute left-3.5 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button @onclick="() => searchQuery = string.Empty" class="absolute right-3 top-3 text-surface-400 hover:text-surface-200 text-xs">
                        ✕
                    </button>
                }
            </div>

            <!-- Filter tabs -->
            <div class="flex items-center gap-1.5 bg-surface-800 p-1 rounded-xl border border-surface-700 text-xs">
                <button type="button" @onclick='() => filtroEstado = "todos"'
                        class="px-3 py-1.5 rounded-lg font-medium transition-colors @(filtroEstado == "todos" ? "bg-primary-600 text-white shadow" : "text-surface-400 hover:text-surface-200")">
                    Todos (@clientes.Count)
                </button>
                <button type="button" @onclick='() => filtroEstado = "deudores"'
                        class="px-3 py-1.5 rounded-lg font-medium transition-colors @(filtroEstado == "deudores" ? "bg-rose-600 text-white shadow" : "text-surface-400 hover:text-surface-200")">
                    Con Deuda (@ClientesConDeudaCount)
                </button>
                <button type="button" @onclick='() => filtroEstado = "aldia"'
                        class="px-3 py-1.5 rounded-lg font-medium transition-colors @(filtroEstado == "aldia" ? "bg-emerald-600 text-white shadow" : "text-surface-400 hover:text-surface-200")">
                    Al Día (@(clientes.Count - ClientesConDeudaCount))
                </button>
            </div>
        </div>

        @if (HomonymCount > 0)
        {
            <div class="p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl text-amber-300 text-xs flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                </svg>
                <span>
                    <strong>Atención con homónimos:</strong> Se detectaron clientes con nombres idénticos o similares. Utilice el <strong>DNI</strong> o el <strong>N° de Cliente (#ID)</strong> para identificar con exactitud al fiador en el POS.
                </span>
            </div>
        }
    </div>

    <!-- Table -->
    <div class="bg-surface-900 border border-surface-800 rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-surface-800 bg-surface-900/50">
                        <th class="text-left py-3.5 px-4 text-surface-400 font-semibold text-xs tracking-wider">ID</th>
                        <th class="text-left py-3.5 px-4 text-surface-400 font-semibold text-xs tracking-wider">Cliente</th>
                        <th class="text-left py-3.5 px-4 text-surface-400 font-semibold text-xs tracking-wider">Documento (DNI / RUC)</th>
                        <th class="text-left py-3.5 px-4 text-surface-400 font-semibold text-xs tracking-wider">Contacto</th>
                        <th class="text-right py-3.5 px-4 text-surface-400 font-semibold text-xs tracking-wider">Saldo Deudor</th>
                        <th class="text-right py-3.5 px-4 text-surface-400 font-semibold text-xs tracking-wider">Límite / Crédito</th>
                        <th class="text-center py-3.5 px-4 text-surface-400 font-semibold text-xs tracking-wider">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-800/50">
                    @foreach (var c in FilteredClientes)
                    {
                        var isHomonym = IsHomonym(c);
                        var disponible = Math.Max(0, c.LimiteCredito - c.SaldoDeudor);
                        var usagePct = c.LimiteCredito > 0 ? Math.Min(100, (double)(c.SaldoDeudor / c.LimiteCredito * 100)) : (c.SaldoDeudor > 0 ? 100 : 0);

                        <tr class="hover:bg-surface-800/30 transition-colors">
                            <!-- ID -->
                            <td class="py-3.5 px-4">
                                <span class="px-2 py-0.5 bg-surface-800 border border-surface-700 text-primary-400 rounded-md font-mono text-xs font-bold">
                                    #@c.Id
                                </span>
                            </td>

                            <!-- Nombre & Homonym info -->
                            <td class="py-3.5 px-4">
                                <div class="space-y-0.5">
                                    <div class="flex items-center gap-2">
                                        <span class="text-surface-100 font-semibold">@c.Nombre</span>
                                        @if (isHomonym)
                                        {
                                            <span class="px-1.5 py-0.5 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded text-[10px] font-medium" title="Existe otro cliente con nombre similar">
                                                Homónimo
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(c.Direccion))
                                    {
                                        <p class="text-xs text-surface-400 flex items-center gap-1">
                                            <svg class="w-3 h-3 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                                            <span class="truncate max-w-[200px]">@c.Direccion</span>
                                        </p>
                                    }
                                </div>
                            </td>

                            <!-- DNI / RUC -->
                            <td class="py-3.5 px-4 font-mono">
                                @if (!string.IsNullOrEmpty(c.Dni))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-surface-800 border border-surface-700 text-xs text-surface-200">
                                        <span class="text-[10px] text-surface-400 font-sans">DNI:</span>
                                        <span class="font-bold text-surface-100">@c.Dni</span>
                                    </span>
                                }
                                else if (!string.IsNullOrEmpty(c.Ruc))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-surface-800 border border-surface-700 text-xs text-surface-200">
                                        <span class="text-[10px] text-surface-400 font-sans">RUC:</span>
                                        <span class="font-bold text-surface-100">@c.Ruc</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-surface-500 text-xs">Sin documento</span>
                                }
                            </td>

                            <!-- Telefono -->
                            <td class="py-3.5 px-4 text-surface-400 text-xs">
                                @if (!string.IsNullOrEmpty(c.Telefono))
                                {
                                    <span class="inline-flex items-center gap-1 text-surface-300">
                                        <svg class="w-3.5 h-3.5 text-surface-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
                                        @c.Telefono
                                    </span>
                                }
                                else
                                {
                                    <span class="text-surface-500">—</span>
                                }
                            </td>

                            <!-- Saldo Deudor -->
                            <td class="py-3.5 px-4 text-right font-mono">
                                @if (c.SaldoDeudor > 0)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-rose-500/10 border border-rose-500/20 text-rose-400 font-bold">
                                        S/ @c.SaldoDeudor.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-emerald-400 font-medium text-xs">Al día (S/ 0.00)</span>
                                }
                            </td>

                            <!-- Limite & Disponible -->
                            <td class="py-3.5 px-4 text-right">
                                <div class="flex flex-col items-end space-y-1">
                                    <span class="text-xs font-mono text-surface-300">Límite: S/ @c.LimiteCredito.ToString("N2")</span>
                                    @if (c.LimiteCredito > 0)
                                    {
                                        <div class="w-24 bg-surface-800 rounded-full h-1.5 overflow-hidden">
                                            <div class="h-full rounded-full @(usagePct >= 90 ? "bg-rose-500" : usagePct >= 60 ? "bg-amber-500" : "bg-primary-500")"
                                                 style="width: @usagePct%"></div>
                                        </div>
                                        <span class="text-[10px] text-surface-400 font-mono">
                                            Disp: <strong class="@(disponible > 0 ? "text-emerald-400" : "text-rose-400")">S/ @disponible.ToString("N2")</strong>
                                        </span>
                                    }
                                </div>
                            </td>

                            <!-- Acciones -->
                            <td class="py-3.5 px-4 text-center">
                                <div class="flex items-center justify-center gap-1.5">
                                    <button @onclick="() => ShowEdit(c)" title="Editar datos del cliente"
                                            class="p-1.5 text-surface-400 hover:text-primary-400 hover:bg-surface-800 rounded-lg transition-colors">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
                                    </button>
                                    <button @onclick='() => Nav.NavigateTo("/fiados")' title="Ver en Cuentas por Cobrar (Fiados)"
                                            class="p-1.5 text-surface-400 hover:text-amber-400 hover:bg-surface-800 rounded-lg transition-colors">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!FilteredClientes.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-surface-500">
                                <div class="flex flex-col items-center justify-center space-y-2">
                                    <svg class="w-8 h-8 text-surface-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                                    </svg>
                                    <p class="text-sm font-medium">No se encontraron clientes con el criterio especificado</p>
                                    <p class="text-xs text-surface-600">Intente buscar por DNI, N° Cliente (#ID), RUC o Nombre</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create / Edit Modal -->
    @if (showModal)
    {
        <div class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4" @onclick="() => showModal = false">
            <div class="bg-surface-900 border border-surface-700 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden" @onclick:stopPropagation>
                <!-- Modal Header -->
                <div class="p-6 border-b border-surface-800 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-primary-500/10 text-primary-400 flex items-center justify-center font-bold text-base">
                            @(isEditing ? $"#{editClient.Id}" : "+")
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-surface-100">@(isEditing ? $"Editar Cliente #{editClient.Id}" : "Nuevo Cliente Fiador")</h3>
                            <p class="text-xs text-surface-400">Identificación única para asignación de crédito</p>
                        </div>
                    </div>
                    <button @onclick="() => showModal = false" class="text-surface-400 hover:text-surface-200">✕</button>
                </div>

                <!-- Modal Body -->
                <div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
                    <!-- Nombre -->
                    <div>
                        <label class="block text-xs font-semibold text-surface-300 mb-1.5">Nombre Completo o Razón Social *</label>
                        <input type="text" @bind="editClient.Nombre" @bind:event="oninput"
                               placeholder="Ej: Juan Muñoz Quispe / Ferretería San José"
                               class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                        @if (HasPotentialHomonym(editClient.Nombre, editClient.Id))
                        {
                            <p class="text-[11px] text-amber-400 mt-1 flex items-center gap-1">
                                ⚠ <span>Ya existe otro cliente con un nombre similar. Asegúrese de especificar el <strong>DNI</strong> o agregar un identificador (ej: "(Vecino)", "(Taller)").</span>
                            </p>
                        }
                    </div>

                    <!-- DNI and RUC -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-surface-300 mb-1.5">
                                DNI (8 dígitos)
                                <span class="text-[10px] text-primary-400 font-normal">Recomendado</span>
                            </label>
                            <input type="text" @bind="editClient.Dni" @bind:event="oninput" maxlength="8"
                                   placeholder="8 dígitos"
                                   class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                            @if (!string.IsNullOrWhiteSpace(editClient.Dni) && HasDuplicateDni(editClient.Dni, editClient.Id))
                            {
                                <p class="text-[11px] text-rose-400 mt-1">⚠ Este DNI ya está registrado en otro cliente.</p>
                            }
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-surface-300 mb-1.5">RUC (11 dígitos)</label>
                            <input type="text" @bind="editClient.Ruc" maxlength="11"
                                   placeholder="11 dígitos (Empresas)"
                                   class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                        </div>
                    </div>

                    <!-- Telefono & Limite -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-surface-300 mb-1.5">Teléfono / Celular</label>
                            <input type="text" @bind="editClient.Telefono"
                                   placeholder="Ej: 987654321"
                                   class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-surface-300 mb-1.5">Límite de Crédito (S/)</label>
                            <input type="number" @bind="editClient.LimiteCredito" step="10" min="0"
                                   class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-surface-300 mb-1.5">Dirección / Referencia de Ubicación</label>
                        <input type="text" @bind="editClient.Direccion"
                               placeholder="Ej: Jr. Los Pinos 123 (Frente al parque)"
                               class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                    </div>

                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="p-3 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-400 text-xs">
                            @modalError
                        </div>
                    }
                </div>

                <!-- Modal Footer -->
                <div class="p-6 border-t border-surface-800 flex justify-end gap-3">
                    <button @onclick="() => showModal = false" class="px-4 py-2 text-sm text-surface-400 hover:text-surface-200">
                        Cancelar
                    </button>
                    <button @onclick="Save" class="px-5 py-2.5 bg-primary-600 hover:bg-primary-500 text-white rounded-xl text-sm font-medium transition-colors shadow-lg shadow-primary-600/20">
                        @(isEditing ? "Guardar Cambios" : "Crear Cliente")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Cliente> clientes = new();
    private string searchQuery = "";
    private string filtroEstado = "todos";
    private bool showModal, isEditing;
    private Cliente editClient = new();
    private string? modalError;

    private int ClientesConDeudaCount => clientes.Count(c => c.SaldoDeudor > 0);
    private decimal TotalSaldoDeudor => clientes.Sum(c => c.SaldoDeudor);

    private int HomonymCount => clientes
        .GroupBy(c => c.Nombre.Trim().ToLower())
        .Count(g => g.Count() > 1);

    private IEnumerable<Cliente> FilteredClientes
    {
        get
        {
            var list = clientes.AsEnumerable();

            // Status filter
            if (filtroEstado == "deudores")
                list = list.Where(c => c.SaldoDeudor > 0);
            else if (filtroEstado == "aldia")
                list = list.Where(c => c.SaldoDeudor <= 0);

            // Search query (DNI, ID, RUC, Name, Phone, Address)
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.Trim();
                var lower = query.ToLower();
                var isId = int.TryParse(query.TrimStart('#'), out int parsedId);

                list = list.Where(c =>
                    (isId && c.Id == parsedId) ||
                    c.Nombre.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    (c.Dni != null && c.Dni.Contains(query)) ||
                    (c.Ruc != null && c.Ruc.Contains(query)) ||
                    (c.Telefono != null && c.Telefono.Contains(query)) ||
                    (c.Direccion != null && c.Direccion.Contains(query, StringComparison.OrdinalIgnoreCase)));
            }

            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin) { Nav.NavigateTo("/pos"); return; }
        await Load();
    }

    private async Task Load()
    {
        clientes = await ClienteSvc.GetAllAsync();
    }

    private bool IsHomonym(Cliente c)
    {
        return clientes.Count(other => other.Id != c.Id &&
            string.Equals(other.Nombre.Trim(), c.Nombre.Trim(), StringComparison.OrdinalIgnoreCase)) > 0;
    }

    private bool HasPotentialHomonym(string nombre, int currentId)
    {
        if (string.IsNullOrWhiteSpace(nombre) || nombre.Trim().Length < 3) return false;
        var trimmed = nombre.Trim();
        return clientes.Any(other => other.Id != currentId &&
            string.Equals(other.Nombre.Trim(), trimmed, StringComparison.OrdinalIgnoreCase));
    }

    private bool HasDuplicateDni(string dni, int currentId)
    {
        if (string.IsNullOrWhiteSpace(dni)) return false;
        var trimmed = dni.Trim();
        return clientes.Any(other => other.Id != currentId &&
            !string.IsNullOrWhiteSpace(other.Dni) && other.Dni.Trim() == trimmed);
    }

    private void ShowCreate()
    {
        isEditing = false;
        editClient = new() { LimiteCredito = 100m, Activo = true };
        modalError = null;
        showModal = true;
    }

    private void ShowEdit(Cliente c)
    {
        isEditing = true;
        editClient = new()
        {
            Id = c.Id,
            Nombre = c.Nombre,
            Dni = c.Dni,
            Ruc = c.Ruc,
            Direccion = c.Direccion,
            Telefono = c.Telefono,
            LimiteCredito = c.LimiteCredito,
            SaldoDeudor = c.SaldoDeudor,
            Activo = c.Activo
        };
        modalError = null;
        showModal = true;
    }

    private async Task Save()
    {
        modalError = null;

        if (string.IsNullOrWhiteSpace(editClient.Nombre))
        {
            modalError = "El nombre del cliente es obligatorio.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(editClient.Dni))
        {
            editClient.Dni = editClient.Dni.Trim();
            if (editClient.Dni.Length != 8 || !long.TryParse(editClient.Dni, out _))
            {
                modalError = "El DNI debe contener exactamente 8 dígitos numéricos.";
                return;
            }

            if (HasDuplicateDni(editClient.Dni, editClient.Id))
            {
                modalError = $"El DNI {editClient.Dni} ya está registrado en otro cliente. Ingrese un DNI único.";
                return;
            }
        }

        if (!string.IsNullOrWhiteSpace(editClient.Ruc))
        {
            editClient.Ruc = editClient.Ruc.Trim();
            if (editClient.Ruc.Length != 11 || !long.TryParse(editClient.Ruc, out _))
            {
                modalError = "El RUC debe contener exactamente 11 dígitos numéricos.";
                return;
            }
        }

        editClient.Nombre = editClient.Nombre.Trim();
        editClient.Direccion = string.IsNullOrWhiteSpace(editClient.Direccion) ? null : editClient.Direccion.Trim();
        editClient.Telefono = string.IsNullOrWhiteSpace(editClient.Telefono) ? null : editClient.Telefono.Trim();

        if (isEditing)
        {
            await ClienteSvc.UpdateAsync(editClient);
        }
        else
        {
            await ClienteSvc.CreateAsync(editClient);
        }

        await Load();
        showModal = false;
    }
}
