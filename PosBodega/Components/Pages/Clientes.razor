@page "/clientes"
@inject AuthService Auth
@inject ClienteService ClienteSvc
@inject NavigationManager Nav

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-surface-50">Clientes</h1>
            <p class="text-surface-400 text-sm mt-1">Gestión de clientes con crédito (fiado)</p>
        </div>
        <button @onclick="ShowCreate" class="flex items-center gap-2 px-4 py-2.5 bg-primary-600 hover:bg-primary-500 text-white rounded-xl font-medium text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Nuevo Cliente
        </button>
    </div>

    <div class="bg-surface-900 border border-surface-800 rounded-xl overflow-hidden">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-surface-800 bg-surface-900/50">
                    <th class="text-left py-3 px-4 text-surface-400 font-medium">Nombre</th>
                    <th class="text-left py-3 px-4 text-surface-400 font-medium">DNI</th>
                    <th class="text-left py-3 px-4 text-surface-400 font-medium">Teléfono</th>
                    <th class="text-right py-3 px-4 text-surface-400 font-medium">Saldo Deudor</th>
                    <th class="text-right py-3 px-4 text-surface-400 font-medium">Límite Crédito</th>
                    <th class="text-center py-3 px-4 text-surface-400 font-medium">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in clientes)
                {
                    <tr class="border-b border-surface-800/50 hover:bg-surface-800/30 transition-colors">
                        <td class="py-3 px-4 text-surface-200 font-medium">@c.Nombre</td>
                        <td class="py-3 px-4 text-surface-400">@(c.Dni ?? "—")</td>
                        <td class="py-3 px-4 text-surface-400">@(c.Telefono ?? "—")</td>
                        <td class="py-3 px-4 text-right font-mono @(c.SaldoDeudor > 0 ? "text-rose-400 font-medium" : "text-surface-400")">
                            S/ @c.SaldoDeudor.ToString("N2")
                        </td>
                        <td class="py-3 px-4 text-right text-surface-400 font-mono">S/ @c.LimiteCredito.ToString("N2")</td>
                        <td class="py-3 px-4 text-center">
                            <button @onclick="() => ShowEdit(c)" class="p-1.5 text-surface-500 hover:text-primary-400 transition-colors">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
                            </button>
                        </td>
                    </tr>
                }
                @if (clientes.Count == 0)
                {
                    <tr><td colspan="6" class="py-8 text-center text-surface-500">No hay clientes registrados</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (showModal)
    {
        <div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" @onclick="() => showModal = false">
            <div class="bg-surface-900 border border-surface-700 rounded-2xl w-full max-w-md shadow-2xl" @onclick:stopPropagation>
                <div class="p-6 border-b border-surface-800">
                    <h3 class="text-lg font-semibold text-surface-100">@(isEditing ? "Editar Cliente" : "Nuevo Cliente")</h3>
                </div>
                <div class="p-6 space-y-4">
                    <div>
                        <label class="block text-sm text-surface-300 mb-1.5">Nombre *</label>
                        <input type="text" @bind="editClient.Nombre" class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm text-surface-300 mb-1.5">DNI</label>
                            <input type="text" @bind="editClient.Dni" maxlength="8" class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                        </div>
                        <div>
                            <label class="block text-sm text-surface-300 mb-1.5">Teléfono</label>
                            <input type="text" @bind="editClient.Telefono" class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm text-surface-300 mb-1.5">Límite de Crédito (S/)</label>
                        <input type="number" @bind="editClient.LimiteCredito" step="10" min="0" class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                    </div>
                </div>
                <div class="p-6 border-t border-surface-800 flex justify-end gap-3">
                    <button @onclick="() => showModal = false" class="px-4 py-2 text-sm text-surface-400">Cancelar</button>
                    <button @onclick="Save" class="px-5 py-2 bg-primary-600 hover:bg-primary-500 text-white rounded-xl text-sm font-medium transition-colors">
                        @(isEditing ? "Guardar" : "Crear")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Cliente> clientes = new();
    private bool showModal, isEditing;
    private Cliente editClient = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin) { Nav.NavigateTo("/pos"); return; }
        await Load();
    }

    private async Task Load() => clientes = await ClienteSvc.GetAllAsync();
    private void ShowCreate() { isEditing = false; editClient = new(); showModal = true; }
    private void ShowEdit(Cliente c) { isEditing = true; editClient = new() { Id = c.Id, Nombre = c.Nombre, Dni = c.Dni, Telefono = c.Telefono, LimiteCredito = c.LimiteCredito, SaldoDeudor = c.SaldoDeudor, Activo = c.Activo }; showModal = true; }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(editClient.Nombre)) return;
        if (isEditing) await ClienteSvc.UpdateAsync(editClient);
        else await ClienteSvc.CreateAsync(editClient);
        await Load(); showModal = false;
    }
}
