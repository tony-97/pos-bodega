@page "/categorias"
@inject AuthService Auth
@inject CategoriaService CategoriaSvc
@inject NavigationManager Nav

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-surface-50">Categorías</h1>
            <p class="text-surface-400 text-sm mt-1">Clasificación de productos</p>
        </div>
        <button @onclick="ShowCreate" class="flex items-center gap-2 px-4 py-2.5 bg-primary-600 hover:bg-primary-500 text-white rounded-xl font-medium text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Nueva Categoría
        </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var cat in categorias)
        {
            <div class="bg-surface-900 border border-surface-800 rounded-xl p-5 hover:border-surface-700 transition-colors group">
                <div class="flex items-start justify-between">
                    <div>
                        <h3 class="text-base font-semibold text-surface-100">@cat.Nombre</h3>
                        <p class="text-sm text-surface-500 mt-1">@(cat.Descripcion ?? "Sin descripción")</p>
                        <p class="text-xs text-surface-600 mt-2">@cat.Productos.Count productos</p>
                    </div>
                    <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button @onclick="() => ShowEdit(cat)" class="p-1.5 text-surface-500 hover:text-primary-400 transition-colors" title="Editar">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
                        </button>
                        @if (cat.Productos.Count == 0)
                        {
                            <button @onclick="() => Delete(cat.Id)" class="p-1.5 text-surface-500 hover:text-rose-400 transition-colors" title="Eliminar">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (showModal)
    {
        <div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" @onclick="() => showModal = false">
            <div class="bg-surface-900 border border-surface-700 rounded-2xl w-full max-w-md shadow-2xl" @onclick:stopPropagation>
                <div class="p-6 border-b border-surface-800">
                    <h3 class="text-lg font-semibold text-surface-100">@(isEditing ? "Editar Categoría" : "Nueva Categoría")</h3>
                </div>
                <div class="p-6 space-y-4">
                    <div>
                        <label class="block text-sm text-surface-300 mb-1.5">Nombre *</label>
                        <input type="text" @bind="editCat.Nombre" class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                    </div>
                    <div>
                        <label class="block text-sm text-surface-300 mb-1.5">Descripción</label>
                        <textarea @bind="editCat.Descripcion" rows="3" class="w-full px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50 resize-none"></textarea>
                    </div>
                </div>
                <div class="p-6 border-t border-surface-800 flex justify-end gap-3">
                    <button @onclick="() => showModal = false" class="px-4 py-2 text-sm text-surface-400 hover:text-surface-200">Cancelar</button>
                    <button @onclick="Save" class="px-5 py-2 bg-primary-600 hover:bg-primary-500 text-white rounded-xl text-sm font-medium transition-colors">
                        @(isEditing ? "Guardar" : "Crear")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Categoria> categorias = new();
    private bool showModal;
    private bool isEditing;
    private Categoria editCat = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin) { Nav.NavigateTo("/pos"); return; }
        await Load();
    }

    private async Task Load() => categorias = await CategoriaSvc.GetAllAsync();

    private void ShowCreate() { isEditing = false; editCat = new(); showModal = true; }

    private void ShowEdit(Categoria c) { isEditing = true; editCat = new() { Id = c.Id, Nombre = c.Nombre, Descripcion = c.Descripcion }; showModal = true; }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(editCat.Nombre)) return;
        if (isEditing) await CategoriaSvc.UpdateAsync(editCat);
        else await CategoriaSvc.CreateAsync(editCat);
        await Load(); showModal = false;
    }

    private async Task Delete(int id) { await CategoriaSvc.DeleteAsync(id); await Load(); }
}
