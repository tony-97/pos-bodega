@page "/fiados"
@inject AuthService Auth
@inject ClienteService ClienteSvc
@inject PagoFiadoService PagoSvc
@inject NavigationManager Nav

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-surface-50">Cuentas por Cobrar (Fiados)</h1>
            <p class="text-surface-400 text-sm mt-1">Control de créditos y pagos con búsqueda exacta por DNI y N° Cliente (#ID)</p>
        </div>
        <button @onclick='() => Nav.NavigateTo("/clientes")' class="flex items-center gap-2 px-4 py-2 bg-surface-800 hover:bg-surface-700 text-surface-200 border border-surface-700 rounded-xl text-xs font-medium transition-colors">
            <svg class="w-4 h-4 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
            Ver Catálogo de Clientes
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Debtors / Clients list -->
        <div class="lg:col-span-1 space-y-3">
            <!-- Search bar -->
            <div class="space-y-2">
                <div class="relative">
                    <input type="text" @bind="searchQuery" @bind:event="oninput"
                           placeholder="Buscar por DNI, N° (#ID), RUC, Nombre..."
                           class="w-full pl-9 pr-4 py-2.5 bg-surface-900 border border-surface-800 rounded-xl text-surface-100 placeholder-surface-500 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                    <svg class="w-4 h-4 text-surface-400 absolute left-3 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button @onclick="() => searchQuery = string.Empty" class="absolute right-3 top-3 text-surface-400 hover:text-surface-200 text-xs">
                            ✕
                        </button>
                    }
                </div>

                <!-- Quick Filter Toggle -->
                <div class="flex items-center gap-1 bg-surface-900 p-1 rounded-xl border border-surface-800 text-xs">
                    <button type="button" @onclick="() => soloConDeuda = true"
                            class="flex-1 py-1.5 rounded-lg font-medium transition-colors text-center @(soloConDeuda ? "bg-rose-600/90 text-white shadow-sm" : "text-surface-400 hover:text-surface-200")">
                        Con Deuda (@clientes.Count(c => c.SaldoDeudor > 0))
                    </button>
                    <button type="button" @onclick="() => soloConDeuda = false"
                            class="flex-1 py-1.5 rounded-lg font-medium transition-colors text-center @(!soloConDeuda ? "bg-surface-800 text-surface-200" : "text-surface-400 hover:text-surface-200")">
                        Todos (@clientes.Count)
                    </button>
                </div>
            </div>

            <!-- Client Cards List -->
            <div class="space-y-2 max-h-[calc(100vh-16rem)] overflow-y-auto pr-1">
                @foreach (var c in FilteredClientes)
                {
                    var client = c;
                    var isSelected = selectedCliente?.Id == client.Id;
                    var isHomonym = IsHomonym(client);
                    var pct = client.LimiteCredito > 0 ? Math.Min(100, (double)(client.SaldoDeudor / client.LimiteCredito * 100)) : (client.SaldoDeudor > 0 ? 100 : 0);

                    <button @onclick="() => SelectCliente(client)"
                            class="w-full text-left p-3.5 rounded-xl border transition-all @(isSelected ? "bg-primary-600/15 border-primary-500/50 shadow-md ring-1 ring-primary-500/20" : "bg-surface-900 border-surface-800 hover:border-surface-700 hover:bg-surface-850")">
                        <div class="flex items-start justify-between gap-2">
                            <div class="space-y-1">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="px-1.5 py-0.5 bg-surface-800 border border-surface-700 text-primary-400 rounded text-[11px] font-mono font-bold">
                                        #@client.Id
                                    </span>
                                    <span class="font-semibold text-surface-100 text-sm">@client.Nombre</span>
                                    @if (isHomonym)
                                    {
                                        <span class="px-1 py-0.2 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded text-[9px] font-bold">
                                            Homónimo
                                        </span>
                                    }
                                </div>
                                <div class="flex items-center gap-2 text-xs text-surface-400 font-mono">
                                    @if (!string.IsNullOrEmpty(client.Dni))
                                    {
                                        <span class="text-surface-300">DNI: <strong class="text-surface-200">@client.Dni</strong></span>
                                    }
                                    else if (!string.IsNullOrEmpty(client.Ruc))
                                    {
                                        <span class="text-surface-300">RUC: <strong class="text-surface-200">@client.Ruc</strong></span>
                                    }
                                    @if (!string.IsNullOrEmpty(client.Telefono))
                                    {
                                        <span class="text-surface-500 font-sans">· @client.Telefono</span>
                                    }
                                </div>
                            </div>
                            <div class="text-right shrink-0">
                                <p class="text-sm font-bold font-mono @(client.SaldoDeudor > 0 ? "text-rose-400" : "text-emerald-400")">
                                    S/ @client.SaldoDeudor.ToString("N2")
                                </p>
                                <span class="text-[10px] text-surface-500">
                                    @(client.SaldoDeudor > 0 ? "Deuda" : "Sin deuda")
                                </span>
                            </div>
                        </div>

                        @if (client.LimiteCredito > 0)
                        {
                            <div class="mt-2.5 space-y-1">
                                <div class="w-full bg-surface-800 rounded-full h-1.5 overflow-hidden">
                                    <div class="h-1.5 rounded-full @(pct >= 90 ? "bg-rose-500" : pct >= 60 ? "bg-amber-500" : "bg-primary-500")"
                                         style="width: @pct%"></div>
                                </div>
                                <div class="flex justify-between text-[10px] text-surface-500">
                                    <span>Límite: S/ @client.LimiteCredito.ToString("N2")</span>
                                    <span>Disp: S/ @(Math.Max(0, client.LimiteCredito - client.SaldoDeudor)).ToString("N2")</span>
                                </div>
                            </div>
                        }
                    </button>
                }
                @if (!FilteredClientes.Any())
                {
                    <div class="text-center py-10 px-4 bg-surface-900 border border-surface-800 rounded-xl text-surface-500 text-sm">
                        <p class="font-medium text-surface-400">No se encontraron clientes</p>
                        <p class="text-xs text-surface-600 mt-1">@(soloConDeuda ? "No hay clientes con deuda pendiente" : "Verifique el término de búsqueda")</p>
                    </div>
                }
            </div>
        </div>

        <!-- Client detail & Payment -->
        <div class="lg:col-span-2">
            @if (selectedCliente != null)
            {
                var disponible = Math.Max(0, selectedCliente.LimiteCredito - selectedCliente.SaldoDeudor);
                var isHomonym = IsHomonym(selectedCliente);

                <div class="bg-surface-900 border border-surface-800 rounded-xl overflow-hidden shadow-sm space-y-0">
                    <!-- Client header -->
                    <div class="p-6 border-b border-surface-800 bg-surface-850/50">
                        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                            <div class="space-y-1.5">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="px-2 py-0.5 bg-primary-600/20 text-primary-300 border border-primary-500/30 rounded-md font-mono text-xs font-bold">
                                        N° Cliente: #@selectedCliente.Id
                                    </span>
                                    <h2 class="text-xl font-bold text-surface-50">@selectedCliente.Nombre</h2>
                                    @if (isHomonym)
                                    {
                                        <span class="px-2 py-0.5 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded text-xs font-medium">
                                            ⚠ Homónimo detectado
                                        </span>
                                    }
                                </div>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-surface-400">
                                    @if (!string.IsNullOrEmpty(selectedCliente.Dni))
                                    {
                                        <span class="font-mono bg-surface-800 px-2 py-0.5 rounded border border-surface-700">
                                            DNI: <strong class="text-surface-100">@selectedCliente.Dni</strong>
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(selectedCliente.Ruc))
                                    {
                                        <span class="font-mono bg-surface-800 px-2 py-0.5 rounded border border-surface-700">
                                            RUC: <strong class="text-surface-100">@selectedCliente.Ruc</strong>
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(selectedCliente.Telefono))
                                    {
                                        <span>Tel: <strong class="text-surface-200">@selectedCliente.Telefono</strong></span>
                                    }
                                    @if (!string.IsNullOrEmpty(selectedCliente.Direccion))
                                    {
                                        <span>Dir: <strong class="text-surface-200">@selectedCliente.Direccion</strong></span>
                                    }
                                </div>
                            </div>

                            <!-- Total Debt Card -->
                            <div class="text-left sm:text-right bg-surface-900 p-3 rounded-xl border border-surface-800 sm:border-0 sm:p-0">
                                <p class="text-xs text-surface-400 font-medium">Deuda Total Acumulada</p>
                                <p class="text-3xl font-extrabold font-mono @(selectedCliente.SaldoDeudor > 0 ? "text-rose-400" : "text-emerald-400")">
                                    S/ @selectedCliente.SaldoDeudor.ToString("N2")
                                </p>
                            </div>
                        </div>

                        <!-- Credit Metric Cards -->
                        <div class="grid grid-cols-3 gap-3 mt-4 pt-4 border-t border-surface-800/80">
                            <div class="bg-surface-900/80 border border-surface-800 rounded-lg p-2.5 text-center">
                                <span class="text-[10px] text-surface-400 uppercase tracking-wider block">Límite Aprobado</span>
                                <span class="text-sm font-bold text-surface-200 font-mono">S/ @selectedCliente.LimiteCredito.ToString("N2")</span>
                            </div>
                            <div class="bg-surface-900/80 border border-surface-800 rounded-lg p-2.5 text-center">
                                <span class="text-[10px] text-surface-400 uppercase tracking-wider block">Crédito Disponible</span>
                                <span class="text-sm font-bold font-mono @(disponible > 0 ? "text-emerald-400" : "text-rose-400")">
                                    S/ @disponible.ToString("N2")
                                </span>
                            </div>
                            <div class="bg-surface-900/80 border border-surface-800 rounded-lg p-2.5 text-center">
                                <span class="text-[10px] text-surface-400 uppercase tracking-wider block">Total Abonado</span>
                                <span class="text-sm font-bold text-primary-400 font-mono">S/ @pagos.Sum(p => p.Monto).ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Register Payment Section -->
                    @if (selectedCliente.SaldoDeudor > 0)
                    {
                        <div class="p-6 border-b border-surface-800 bg-surface-850">
                            <div class="flex items-center justify-between mb-3">
                                <h3 class="text-sm font-bold text-surface-200 flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                                    Registrar Abono o Cancelación
                                </h3>
                                <!-- Quick Amount Shortcuts -->
                                <div class="flex items-center gap-1 text-xs">
                                    <button type="button" @onclick="() => SetPagoMonto(10)" class="px-2 py-1 bg-surface-800 hover:bg-surface-700 text-surface-300 rounded-md font-mono">S/ 10</button>
                                    <button type="button" @onclick="() => SetPagoMonto(20)" class="px-2 py-1 bg-surface-800 hover:bg-surface-700 text-surface-300 rounded-md font-mono">S/ 20</button>
                                    <button type="button" @onclick="() => SetPagoMonto(50)" class="px-2 py-1 bg-surface-800 hover:bg-surface-700 text-surface-300 rounded-md font-mono">S/ 50</button>
                                    <button type="button" @onclick="() => SetPagoMonto(selectedCliente.SaldoDeudor)" class="px-2 py-1 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 rounded-md font-mono font-bold">Total (S/ @selectedCliente.SaldoDeudor.ToString("N2"))</button>
                                </div>
                            </div>

                            <div class="flex flex-col sm:flex-row gap-3">
                                <div class="sm:w-1/3">
                                    <input type="number" @bind="pagoMonto" step="0.10" min="0.10" max="@selectedCliente.SaldoDeudor"
                                           placeholder="Monto S/ 0.00"
                                           class="w-full px-3.5 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm font-mono font-bold focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                                </div>
                                <div class="sm:w-1/2">
                                    <input type="text" @bind="pagoObservaciones"
                                           placeholder="Observación o referencia (opcional)..."
                                           class="w-full px-3.5 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                                </div>
                                <div class="sm:w-auto">
                                    <button @onclick="RegistrarPago"
                                            class="w-full px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-sm font-semibold transition-all shadow-md shadow-emerald-600/20 flex items-center justify-center gap-1.5 whitespace-nowrap">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                                        Registrar Abono
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(pagoError))
                            {
                                <div class="mt-2.5 p-2.5 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-400 text-xs">
                                    @pagoError
                                </div>
                            }
                            @if (pagoSuccess)
                            {
                                <div class="mt-2.5 p-2.5 bg-emerald-500/10 border border-emerald-500/20 rounded-xl text-emerald-400 text-xs flex items-center gap-1.5 font-medium">
                                    <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                                    Abono registrado con éxito y saldo actualizado.
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-4 bg-emerald-500/5 border-b border-surface-800 flex items-center gap-2 text-emerald-400 text-xs">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                            <span>Este cliente se encuentra al día, no registra deuda pendiente.</span>
                        </div>
                    }

                    <!-- Payment History Section -->
                    <div class="p-6 space-y-3">
                        <div class="flex items-center justify-between">
                            <h3 class="text-sm font-bold text-surface-200">Historial de Abonos y Pagos</h3>
                            <span class="text-xs text-surface-500">@pagos.Count transacciones registradas</span>
                        </div>

                        @if (pagos.Count > 0)
                        {
                            <div class="overflow-x-auto">
                                <table class="w-full text-xs">
                                    <thead>
                                        <tr class="border-b border-surface-800 bg-surface-850/40">
                                            <th class="text-left py-2.5 px-3 text-surface-400 font-semibold">Fecha y Hora</th>
                                            <th class="text-right py-2.5 px-3 text-surface-400 font-semibold">Monto Pagado</th>
                                            <th class="text-right py-2.5 px-3 text-surface-400 font-semibold">Saldo Anterior</th>
                                            <th class="text-right py-2.5 px-3 text-surface-400 font-semibold">Saldo Restante</th>
                                            <th class="text-left py-2.5 px-3 text-surface-400 font-semibold">Observación</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-surface-800/40">
                                        @foreach (var p in pagos)
                                        {
                                            <tr class="hover:bg-surface-800/30 transition-colors">
                                                <td class="py-2.5 px-3 text-surface-300 font-mono">
                                                    @p.Fecha.ToString("dd/MM/yyyy HH:mm")
                                                </td>
                                                <td class="py-2.5 px-3 text-right text-emerald-400 font-mono font-bold">
                                                    S/ @p.Monto.ToString("N2")
                                                </td>
                                                <td class="py-2.5 px-3 text-right text-surface-400 font-mono">
                                                    S/ @p.SaldoAnterior.ToString("N2")
                                                </td>
                                                <td class="py-2.5 px-3 text-right text-surface-200 font-mono font-semibold">
                                                    S/ @p.SaldoRestante.ToString("N2")
                                                </td>
                                                <td class="py-2.5 px-3 text-surface-400">
                                                    @(string.IsNullOrEmpty(p.Observaciones) ? "—" : p.Observaciones)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8 text-surface-500 text-xs border border-dashed border-surface-800 rounded-xl">
                                No se han registrado abonos para este cliente todavía.
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center justify-center h-full min-h-[350px] bg-surface-900/50 border border-surface-800 rounded-xl text-surface-500 py-16 px-4 text-center">
                    <div class="w-14 h-14 rounded-2xl bg-surface-800 text-surface-600 flex items-center justify-center mb-3">
                        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                        </svg>
                    </div>
                    <p class="text-sm font-semibold text-surface-300">Seleccione un cliente de la lista</p>
                    <p class="text-xs text-surface-500 mt-1 max-w-sm">
                        Busque por <strong>DNI</strong> o <strong>N° (#ID)</strong> para acceder al detalle de cuenta y registrar abonos sin riesgo de confusión con homónimos.
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public int? ClienteId { get; set; }

    private List<Cliente> clientes = new();
    private Cliente? selectedCliente;
    private List<PagoFiado> pagos = new();
    private string searchQuery = "";
    private bool soloConDeuda = true;
    private decimal pagoMonto;
    private string pagoObservaciones = "";
    private string? pagoError;
    private bool pagoSuccess;

    private IEnumerable<Cliente> FilteredClientes
    {
        get
        {
            var list = clientes.AsEnumerable();

            if (soloConDeuda)
            {
                list = list.Where(c => c.SaldoDeudor > 0);
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.Trim();
                var isId = int.TryParse(query.TrimStart('#'), out int parsedId);

                list = list.Where(c =>
                    (isId && c.Id == parsedId) ||
                    c.Nombre.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    (c.Dni != null && c.Dni.Contains(query)) ||
                    (c.Ruc != null && c.Ruc.Contains(query)) ||
                    (c.Telefono != null && c.Telefono.Contains(query)));
            }

            return soloConDeuda ? list.OrderByDescending(c => c.SaldoDeudor) : list.OrderBy(c => c.Nombre);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        clientes = await ClienteSvc.GetAllAsync();

        if (ClienteId.HasValue && ClienteId.Value > 0)
        {
            var target = clientes.FirstOrDefault(c => c.Id == ClienteId.Value);
            if (target != null)
            {
                soloConDeuda = false;
                await SelectCliente(target);
            }
        }
        else if (clientes.Any(c => c.SaldoDeudor > 0))
        {
            var firstDeudor = clientes.Where(c => c.SaldoDeudor > 0).OrderByDescending(c => c.SaldoDeudor).FirstOrDefault();
            if (firstDeudor != null)
            {
                await SelectCliente(firstDeudor);
            }
        }
    }

    private bool IsHomonym(Cliente c)
    {
        return clientes.Count(other => other.Id != c.Id &&
            string.Equals(other.Nombre.Trim(), c.Nombre.Trim(), StringComparison.OrdinalIgnoreCase)) > 0;
    }

    private void SetPagoMonto(decimal monto)
    {
        pagoMonto = monto;
        pagoError = null;
        pagoSuccess = false;
    }

    private async Task SelectCliente(Cliente c)
    {
        selectedCliente = c;
        pagos = await PagoSvc.GetByClienteAsync(c.Id);
        pagoError = null;
        pagoSuccess = false;
        pagoMonto = 0;
        pagoObservaciones = "";
    }

    private async Task RegistrarPago()
    {
        pagoError = null;
        pagoSuccess = false;

        if (selectedCliente == null) return;
        if (pagoMonto <= 0)
        {
            pagoError = "Ingrese un monto mayor a 0 para el abono.";
            return;
        }

        var error = await PagoSvc.RegistrarPagoAsync(selectedCliente.Id, pagoMonto, pagoObservaciones);
        if (error != null)
        {
            pagoError = error;
        }
        else
        {
            pagoSuccess = true;
            clientes = await ClienteSvc.GetAllAsync();
            selectedCliente = clientes.FirstOrDefault(c => c.Id == selectedCliente.Id);
            if (selectedCliente != null)
                pagos = await PagoSvc.GetByClienteAsync(selectedCliente.Id);
            pagoMonto = 0;
            pagoObservaciones = "";
        }
    }
}
