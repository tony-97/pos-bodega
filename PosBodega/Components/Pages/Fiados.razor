@page "/fiados"
@inject AuthService Auth
@inject ClienteService ClienteSvc
@inject PagoFiadoService PagoSvc

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-surface-50">Fiados</h1>
        <p class="text-surface-400 text-sm mt-1">Gestión de cuentas por cobrar</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Debtors list -->
        <div class="lg:col-span-1 space-y-3">
            <div class="relative">
                <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Buscar cliente..."
                       class="w-full px-3 py-2.5 bg-surface-900 border border-surface-800 rounded-xl text-surface-100 placeholder-surface-500 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
            </div>

            <div class="space-y-2 max-h-[calc(100vh-14rem)] overflow-y-auto">
                @foreach (var c in FilteredClientes)
                {
                    var client = c;
                    <button @onclick="() => SelectCliente(client)"
                            class="w-full text-left p-4 rounded-xl border transition-all @(selectedCliente?.Id == client.Id ? "bg-primary-600/10 border-primary-500/30" : "bg-surface-900 border-surface-800 hover:border-surface-700")">
                        <div class="flex items-center justify-between">
                            <p class="font-medium text-surface-200">@client.Nombre</p>
                            <p class="text-sm font-bold @(client.SaldoDeudor > 0 ? "text-rose-400" : "text-emerald-400")">
                                S/ @client.SaldoDeudor.ToString("N2")
                            </p>
                        </div>
                        @if (client.SaldoDeudor > 0)
                        {
                            <div class="mt-2 w-full bg-surface-800 rounded-full h-1.5">
                                @{
                                    var pct = client.LimiteCredito > 0 ? Math.Min(100, (double)(client.SaldoDeudor / client.LimiteCredito * 100)) : 100;
                                }
                                <div class="h-1.5 rounded-full @(pct > 80 ? "bg-rose-500" : pct > 50 ? "bg-amber-500" : "bg-primary-500")" style="width: @pct%"></div>
                            </div>
                            <p class="text-xs text-surface-500 mt-1">Límite: S/ @client.LimiteCredito.ToString("N2")</p>
                        }
                    </button>
                }
                @if (!FilteredClientes.Any())
                {
                    <div class="text-center py-8 text-surface-500 text-sm">No hay clientes con deuda</div>
                }
            </div>
        </div>

        <!-- Client detail -->
        <div class="lg:col-span-2">
            @if (selectedCliente != null)
            {
                <div class="bg-surface-900 border border-surface-800 rounded-xl overflow-hidden">
                    <!-- Client header -->
                    <div class="p-6 border-b border-surface-800">
                        <div class="flex items-center justify-between">
                            <div>
                                <h2 class="text-xl font-bold text-surface-50">@selectedCliente.Nombre</h2>
                                <p class="text-sm text-surface-400 mt-1">
                                    @if (!string.IsNullOrEmpty(selectedCliente.Dni)) { <span>DNI: @selectedCliente.Dni</span> }
                                    @if (!string.IsNullOrEmpty(selectedCliente.Telefono)) { <span class="ml-3">Tel: @selectedCliente.Telefono</span> }
                                </p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm text-surface-400">Deuda Total</p>
                                <p class="text-3xl font-bold @(selectedCliente.SaldoDeudor > 0 ? "text-rose-400" : "text-emerald-400")">
                                    S/ @selectedCliente.SaldoDeudor.ToString("N2")
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Register payment -->
                    @if (selectedCliente.SaldoDeudor > 0)
                    {
                        <div class="p-6 border-b border-surface-800 bg-surface-850">
                            <h3 class="text-sm font-semibold text-surface-300 mb-3">Registrar Abono</h3>
                            <div class="flex gap-3">
                                <input type="number" @bind="pagoMonto" step="0.10" min="0.10" placeholder="Monto S/"
                                       class="flex-1 px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                                <input type="text" @bind="pagoObservaciones" placeholder="Observación (opcional)"
                                       class="flex-1 px-3 py-2.5 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50" />
                                <button @onclick="RegistrarPago" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-sm font-medium transition-colors">
                                    Registrar Pago
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(pagoError))
                            {
                                <div class="mt-2 p-2 bg-rose-500/10 border border-rose-500/20 rounded-lg text-rose-400 text-xs">@pagoError</div>
                            }
                            @if (pagoSuccess)
                            {
                                <div class="mt-2 p-2 bg-emerald-500/10 border border-emerald-500/20 rounded-lg text-emerald-400 text-xs">✓ Pago registrado exitosamente</div>
                            }
                        </div>
                    }

                    <!-- Payment history -->
                    <div class="p-6">
                        <h3 class="text-sm font-semibold text-surface-300 mb-3">Historial de Pagos</h3>
                        @if (pagos.Count > 0)
                        {
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-surface-800">
                                        <th class="text-left py-2 text-surface-400 font-medium">Fecha</th>
                                        <th class="text-right py-2 text-surface-400 font-medium">Monto</th>
                                        <th class="text-right py-2 text-surface-400 font-medium">Saldo Anterior</th>
                                        <th class="text-right py-2 text-surface-400 font-medium">Saldo Restante</th>
                                        <th class="text-left py-2 text-surface-400 font-medium">Observación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in pagos)
                                    {
                                        <tr class="border-b border-surface-800/50">
                                            <td class="py-2 text-surface-300">@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="py-2 text-right text-emerald-400 font-mono font-medium">S/ @p.Monto.ToString("N2")</td>
                                            <td class="py-2 text-right text-surface-400 font-mono">S/ @p.SaldoAnterior.ToString("N2")</td>
                                            <td class="py-2 text-right text-surface-200 font-mono">S/ @p.SaldoRestante.ToString("N2")</td>
                                            <td class="py-2 text-surface-500">@(p.Observaciones ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-center py-6 text-surface-500 text-sm">No hay pagos registrados</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center justify-center h-full text-surface-500 py-20">
                    <svg class="w-16 h-16 mb-4 text-surface-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                    </svg>
                    <p class="text-sm">Seleccione un cliente para ver sus detalles</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Cliente> clientes = new();
    private Cliente? selectedCliente;
    private List<PagoFiado> pagos = new();
    private string searchQuery = "";
    private decimal pagoMonto;
    private string pagoObservaciones = "";
    private string? pagoError;
    private bool pagoSuccess;

    private IEnumerable<Cliente> FilteredClientes =>
        string.IsNullOrWhiteSpace(searchQuery) ?
            clientes.Where(c => c.SaldoDeudor > 0).OrderByDescending(c => c.SaldoDeudor) :
            clientes.Where(c => c.Nombre.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        clientes = await ClienteSvc.GetAllAsync();
    }

    private async Task SelectCliente(Cliente c)
    {
        selectedCliente = c;
        pagos = await PagoSvc.GetByClienteAsync(c.Id);
        pagoError = null;
        pagoSuccess = false;
        pagoMonto = 0;
        pagoObservaciones = "";
    }

    private async Task RegistrarPago()
    {
        pagoError = null;
        pagoSuccess = false;

        if (selectedCliente == null) return;

        var error = await PagoSvc.RegistrarPagoAsync(selectedCliente.Id, pagoMonto, pagoObservaciones);
        if (error != null)
        {
            pagoError = error;
        }
        else
        {
            pagoSuccess = true;
            clientes = await ClienteSvc.GetAllAsync();
            selectedCliente = clientes.FirstOrDefault(c => c.Id == selectedCliente.Id);
            if (selectedCliente != null)
                pagos = await PagoSvc.GetByClienteAsync(selectedCliente.Id);
            pagoMonto = 0;
            pagoObservaciones = "";
        }
    }
}
