@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

@if (!Auth.IsAuthenticated)
{
    <div class="min-h-screen flex items-center justify-center bg-surface-950">
        <p class="text-surface-400">Redirigiendo al inicio de sesión...</p>
    </div>
}
else
{
    <div class="flex h-screen overflow-hidden bg-surface-950">
        <!-- Sidebar -->
        <aside class="w-64 flex-shrink-0 bg-surface-900 border-r border-surface-800 flex flex-col">
            <!-- Logo / Brand -->
            <div class="h-16 flex items-center px-6 border-b border-surface-800">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-primary-500 to-primary-700 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-base font-bold text-surface-50">PosBodega</h1>
                        <p class="text-[10px] text-surface-500 -mt-0.5">Punto de Venta</p>
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
                <NavMenu />
            </nav>

            <!-- User info at bottom -->
            <div class="p-4 border-t border-surface-800">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-surface-700 flex items-center justify-center">
                        <svg class="w-5 h-5 text-surface-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-surface-200 truncate">@Auth.CurrentUser?.Nombre</p>
                        <p class="text-xs text-surface-500">@Auth.CurrentUser?.Rol</p>
                    </div>
                    <button @onclick="HandleLogout"
                            class="p-2 rounded-lg text-surface-400 hover:text-rose-400 hover:bg-surface-800 transition-colors"
                            title="Cerrar sesión">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                        </svg>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto">
            <div class="p-6 flex-1">
                @Body
            </div>
        </main>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Auth.OnAuthStateChanged += OnAuthChanged;
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
        }
    }

    private void OnAuthChanged()
    {
        InvokeAsync(() =>
        {
            if (!Auth.IsAuthenticated)
            {
                Nav.NavigateTo("/login");
            }
            StateHasChanged();
        });
    }

    private void HandleLogout()
    {
        Auth.Logout();
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= OnAuthChanged;
    }
}
